# External assets and installed environments; no credentials are stored here.
LFM_ROOT=/path/to/visual_trajectory
LFM_MODEL=/path/to/models/Qwen3-VL-8B-Instruct
LFM_SFT_ENV=/path/to/sft_environment
LFM_RL_ENV=/path/to/grpo_opsd_environment
LFM_INFERENCE_ENV=/path/to/vllm_environment
LFM_GPU_UUIDS=GPU-PLACEHOLDER-0,GPU-PLACEHOLDER-1
# Supply GOOGLE_MAPS_API_KEY separately in your shell for StreetView generation.
